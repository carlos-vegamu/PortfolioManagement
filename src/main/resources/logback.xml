<configuration>
    <!-- The CLI owns stdout, so logs go to a file. -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${PORTFOLIO_LOG_FILE:-logs/portfolio.log}</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
